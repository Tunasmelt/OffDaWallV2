# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin / Ops
ADMIN_API_TOKEN=replace-with-strong-token
# Back-compat alias (optional)
ADMIN_TOKEN=

# Provider keys
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
LASTFM_API_KEY=
AUDIODB_API_KEY=

# Optional diagnostics
DEBUG_MODE=0
DEBUG_PROVIDERS=0

# Optional: only needed if Vercel Deployment Protection is enabled and
# server-side internal API fetches must bypass it.
VERCEL_AUTOMATION_BYPASS_SECRET=forking987654321
